# ─── Server ──────────────────────────────────────────────────────
HTTP_ENABLED=true
HTTP_PORT=8080

# ─── Cloud flag (switches Log4j2 to JSON layout) ────────────────
# CLOUD=true

# ─── JWT Auth (for internal service-to-service endpoints) ───────
#JWT_KEYSTORE_PATH=keystore.p12
#JWT_KEYSTORE_PASSWORD=changeit

# ─── Service Registry DNS suffix (Azure Container Apps) ───────
# REQUIRED for local dev — enables auto-URL construction for all @RegisteredService
# entries that don't specify an explicit url. Without this, guicedee-website,
# jwebmp-website, activity-master-website, and entity-assist-website will NOT register.
CONTAINER_APP_ENV_DNS_SUFFIX=whitegrass-2e17714c.ukwest.azurecontainerapps.io

# ─── Internal service URLs (explicit overrides, only needed if DNS suffix is wrong) ─
# ACTIVITY_MASTER_API_URL=http://localhost:8081
# PAYMENT_SERVICE_URL=http://localhost:8082


